NODE_ENV=development
PORT=3000
# Optional comma-separated DNS resolvers when the network blocks MongoDB SRV lookups.
MONGODB_DNS_SERVERS=
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Sign-ins last this long without use; each time the app opens it gets a fresh token (POST /api/auth/refresh).
JWT_EXPIRES_IN=30d
ALLOWED_ORIGINS=http://localhost:8081
# Optional: email delivery of password-reset codes. Set BREVO_API_KEY (preferred) or SMTP_URL; MAIL_FROM must be a verified sender.
# Without either, the development server writes messages to server/.dev-outbox/.
# BREVO_API_KEY=xkeysib-...
# SMTP_URL=smtps://user:password@smtp.example.com
# MAIL_FROM=Bear Care <no-reply@example.com>
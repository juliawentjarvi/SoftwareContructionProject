{
  "expo": {
    "name": "Bear Care",
    "slug": "bear-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.bearcare.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.bearcare.app"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "color": "#315b49"
        }
      ],
      "expo-secure-store"
    ]
  }
}

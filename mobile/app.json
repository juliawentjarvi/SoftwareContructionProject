{
  "expo": {
    "name": "Bear Care",
    "slug": "bear-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.bearcare.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.bearcare.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#315b49"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "color": "#315b49"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bear Care uses your photos only to let you choose a profile picture."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
